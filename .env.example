# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Tools read these via os.environ; none are required for the core toolchain.

# Unity build automation / service account (optional)
UNITY_SERVICE_ACCOUNT_KEY_ID=
UNITY_SERVICE_ACCOUNT_SECRET=

# Steam upload (optional; used by future steamcmd scripts)
STEAM_USERNAME=

# itch.io butler (optional)
BUTLER_API_KEY=
